  speakerName: "\u6751\u6C11"
  lines:
  - "\u65C5\u884C\u8005\uFF0C\u8BF7\u7559\u6B65\u2026\u2026\u4F60\u662F\u4ECE\u6751\u5916\u6765\u7684\u5417\uFF1F"
  - "\u6700\u8FD1\u897F\u8FB9\u7684\u9B54\u7269\u8D8A\u6765\u8D8A\u7316\u7357\uFF0C\u7CAE\u4ED3\u548C\u6C34\u4E95\u90FD\u5FEB\u6CA1\u4EBA\u6562\u9760\u8FD1\u4E86\u3002"
  - "\u6751\u91CC\u7684\u62A4\u536B\u8FD8\u5728\u517B\u4F24\uFF0C\u6211\u4EEC\u5B9E\u5728\u62FF\u5B83\u4EEC\u6CA1\u529E\u6CD5\u3002"
  - "\u80FD\u8BF7\u4F60\u5E2E\u5FD9\u6E05\u7406 3 \u53EA\u9B54\u7269\u5417\uFF1F\u4E8B\u6210\u4E4B\u540E\uFF0C\u6211\u4F1A\u62FF\u51FA\u5BB6\u91CC\u7684\u56DE\u590D\u836F\u6C34\u4F5C\u4E3A\u8C22\u793C\u3002"
  options:
  - text: "\u4EA4\u7ED9\u6211\u5427"
    nextDialogue: {fileID: 0}
    questToOffer: {fileID: 11400000, guid: 06f3672c043fae64d90732e38163c02c, type: 2}
