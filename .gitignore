# Unity generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Keep Unity metadata for tracked assets
!/[Aa]ssets/**/*.meta

# IDE
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Generated logs, test output and temporary patches
*.log
TestResults*.xml
_patch_*.txt
*.bak
*.bak.meta

# Other Unity-generated files
sysinfo.txt
*.stackdump
crashlytics-build.properties

# Addressables build output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# JetBrains Rider generated files
/[Aa]ssets/Plugins/Editor/JetBrains*

# Exported packages
*.unitypackage

# OS
.DS_Store
Thumbs.db
desktop.ini
