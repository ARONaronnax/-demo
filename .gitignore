# ---------------------------------------------------------------
# Unity 生成目录（必须忽略，否则仓库会膨胀到几个 GB）
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# ---------------------------------------------------------------
# 资源元数据：只有当对应资源也被忽略时才忽略 .meta
# 正常情况下 .meta 必须提交，否则场景和预制体的引用会全部断裂
# ---------------------------------------------------------------
!/[Aa]ssets/**/*.meta

# ---------------------------------------------------------------
# IDE
# ---------------------------------------------------------------
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------
# Unity 生成的其他文件
# ---------------------------------------------------------------
sysinfo.txt
*.stackdump
crashlytics-build.properties

# Addressables 打包产物
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# JetBrains Rider 自动生成
/[Aa]ssets/Plugins/Editor/JetBrains*

# 导出的包
*.unitypackage

# ---------------------------------------------------------------
# 操作系统
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
